# Airtable target for inquiry-triage — copy this to .env and fill in
# your own values. These are identifiers, NOT secrets. The Airtable
# token lives in n8n's own credential store and never goes in this
# file (see credentials.example.json for that).
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_INQUIRIES_TABLE_ID=tblXXXXXXXXXXXXXX

# n8n 2.30+ blocks $env access inside nodes by default. The two
# Airtable nodes ("Airtable Create - Needs Review" / "- Flagged") read
# the two IDs above via $env, so this must be off. Not needed on 2.29
# or earlier - this is a 2.30 behaviour change.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Optional: swap the AI provider the "Ollama Draft + Classify" node
# calls. Defaults to local Ollama if unset. Point this at an OpenAI/
# Anthropic-compatible endpoint to use a hosted model instead - see
# README's "Swapping the AI provider" section for what else that needs
# (this only swaps the URL, not the request body shape or auth header).
AI_PROVIDER_URL=http://127.0.0.1:11434/api/generate
